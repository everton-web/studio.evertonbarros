# Plataforma Asymmetrics: variáveis do servidor (Hostinger, app Node.js gerenciado).
# Copie para .env.local no desenvolvimento. Em produção, cadastre no painel da
# Hostinger. Nenhuma destas variáveis pode ter o prefixo NEXT_PUBLIC_: todas são
# lidas só no servidor e nenhuma vai para o navegador.

# ---------- Supabase (obrigatórias) ----------
# Painel do Supabase > Project Settings > API.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# service_role: contorna RLS. Segredo exclusivo do servidor. Nunca em código cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado criado pelo SETUP-COMPLETO.sql.
SUPABASE_STORAGE_BUCKET=plataforma-arquivos

# ---------- Login da plataforma (obrigatórias em produção) ----------
AGENCIA_USER=everton
AGENCIA_PASS=
# Segredo do cookie de sessão. Gere com: openssl rand -hex 32
AGENCIA_SECRET=

# ---------- Cofre de credenciais ----------
# A MESMA chave usada no SQLite antigo; sem ela as senhas importadas não abrem.
AGENCIA_COFRE_KEY=

# ---------- Formulários externos (POST /api/leads) ----------
LEADS_TOKEN=

# ---------- Relatório mensal ----------
RELATORIO_BASE_URL=https://app.evertonbrito.com

# ---------- InfinitePay ----------
INFINITEPAY_HANDLE=
INFINITEPAY_REDIRECT_URL=
INFINITEPAY_WEBHOOK_URL=https://app.evertonbrito.com/api/infinitepay/webhook

# ---------- Integrações opcionais ----------
GOOGLE_PLACES_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------- Prospecção automática (scraper do Google Maps) ----------
# URL da API do gosom/google-maps-scraper (kit vzbaggio/google-maps-scraper-kit) num VPS
# com Docker, atrás de um proxy com autenticação. Ex.: https://scraper.seudominio.com
GMAPS_SCRAPER_URL=
# Token que o proxy na frente do scraper exige (Authorization: Bearer ...).
GMAPS_SCRAPER_TOKEN=
# Token do agendamento diário (cron do hPanel). Gere com: openssl rand -hex 24
PROSPECTOR_TOKEN=
